# Copie ce fichier en .env et renseigne tes propres clés.
# NE JAMAIS committer ni partager .env (déjà exclu par .gitignore).

# --- Obligatoire ---
TELEGRAM_BOT_TOKEN=
PYTHON_EXECUTABLE_PATH=
SOFASCORE_SERVER_SCRIPT_PATH=

# --- Source "Duo" (gratuite, API officielles) : analyse en parallèle de Sofascore, puis comparaison ---
# 1) https://www.football-data.org/client/register → clé reçue par e-mail
FOOTBALL_DATA_KEY=
# 2) https://the-odds-api.com → offre gratuite (500 crédits/mois) → clé reçue par e-mail
ODDS_API_KEY=
# Sources utilisées (par défaut les deux ; "duo" seul si Sofascore te bloque)
#DATA_SOURCES=sofascore,duo
# Cotes The Odds API gardées 12 h (1 appel = 2 crédits par championnat)
#ODDS_API_CACHE_HOURS=12
#ODDS_API_REGIONS=eu
# Offre gratuite football-data.org : 10 requêtes/minute
#FOOTBALL_DATA_MIN_INTERVAL_MS=6500

# --- Les 3 IA (une IA sans clé est simplement ignorée) ---
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# --- Accès au bot (NOUVEAU, fortement conseillé) ---
# chatId autorisés, séparés par des virgules (envoie /whoami au bot pour connaître le tien).
# AUTO_REPORT_CHAT_ID est automatiquement autorisé.
ALLOWED_CHAT_IDS=

# --- Envoi automatique quotidien (optionnel) ---
AUTO_REPORT_CHAT_ID=
AUTO_REPORT_TIME=17:00
AUTO_REPORT_TIMEZONE=Africa/Porto-Novo
# /semaine par défaut ; /brave reste accepté (alias)
AUTO_REPORT_COMMAND=/semaine

# =====================================================================
# Réglages avancés : tout est optionnel, les valeurs ci-dessous sont
# les valeurs par défaut.
# =====================================================================

# Sofascore
#SOFASCORE_SERVER_PORT=8787
#SOFASCORE_MAX_CONCURRENCY=4
#SOFASCORE_MIN_DELAY_MS=150
#ODDS_CACHE_HOURS=3
#CACHE_DIR=cache
#DATA_DIR=data
# Restreindre les compétitions (ids Sofascore), ex : 17,8,23,35,34
#LEAGUE_IDS=

# Coupons
#COUPON_TARGET_ODDS=10
#COUPON_COUNT=3
#KICKOFF_MARGIN_MINUTES=30
#REPORT_REUSE_MINUTES=60

# Grands matchs du mois (/grandsmatchs)
# réussite estimée minimale du coupon sécurité
#BIG_SAFE_MIN_PROBABILITY=0.50
#BIG_SAFE_COUNT=1
#BIG_LONGSHOT_TARGET_ODDS=120
#BIG_LONGSHOT_COUNT=1
#BIG_MATCHES_MAX=25
# 0.65 = les deux équipes dans le tiers supérieur (Elo)
#BIG_MATCH_STRONG_QUANTILE=0.65

# Pronostics et fiches de match (/pronostics, /analyse)
# contexte joueurs : absents, compositions, note moyenne des joueurs, classement (false pour économiser des requêtes)
#MATCH_DETAILS=true
#PREDICTIONS_MAX=30

# Filtres de fiabilité
# écarte une sélection dont la cote a monté de plus de 8 % depuis l'ouverture
#MAX_ODDS_DRIFT=0.08
# écarte les paris "résultat" si l'Elo contredit le modèle
#MAX_ELO_DISAGREEMENT=0.12

# Modèle
# part du modèle face aux cotes du marché (0 = marché seul, 1 = modèle seul)
#MODEL_WEIGHT=0.5
#DIXON_COLES_RHO=-0.08
#FORM_HALF_LIFE_DAYS=120
#RATING_PRIOR_MATCHES=4
#MIN_TEAM_MATCHES=6

# IA
#AI_MAX_MATCHES=30
#AI_BATCH_SIZE=6
#GEMINI_MODELS=gemini-flash-latest,gemini-3-flash-preview,gemini-flash-lite-latest
#MISTRAL_MODEL=mistral-small-latest
#GROQ_MODEL=openai/gpt-oss-20b
#GROQ_MIN_INTERVAL_MS=20000
#MISTRAL_MIN_INTERVAL_MS=2000
#GEMINI_MIN_INTERVAL_MS=5000

# Affichage
#BOT_TIMEZONE=Africa/Porto-Novo
#DEBUG=1
